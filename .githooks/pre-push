#!/bin/bash
# Safe-push guardrail for jiayan-xu/agent-core (public open-source repo).
# Installed via `git config core.hooksPath .githooks` (canonical checkout) or copied to
# .git/hooks/pre-push (stale checkouts). See AGENTS.md for the full policy.
#
# pre-push receives, per pushed ref, FOUR fields on stdin:
#     <local-ref> <local-oid> <remote-ref> <remote-oid>
# and the remote NAME as $1 (remote URL via `git remote get-url "$1"`).
#
# BLOCKS:
#  - any push from a checkout marked with a root-level .NO_PUSH file
#  - any branch/tag deletion via push (zero local/oid on the SOURCE side)
#  - pushing to a branch other than the canonical default branch
#  - pushing to a remote other than the canonical GitHub remote
#    (this also blocks the `gitee` closed-source mirror by design)

remote_name="$1"
repo_root=$(git rev-parse --show-toplevel 2>/dev/null)

if [ -f "$repo_root/.NO_PUSH" ]; then
  echo "BLOCKED: this local checkout is marked .NO_PUSH (not the canonical publish source)." >&2
  echo "         Edit/push from the canonical directory instead. Aborting." >&2
  exit 1
fi

# 2026-08-07: PR 流程后 DEFAULT_BRANCH 不再被 case 使用（case 硬编码 refs/heads/master），移除死代码
CANONICAL_REMOTE_SUBSTR="github.com/jiayan-xu/agent-core"

while read local_ref local_oid remote_ref remote_oid; do
  # Block deletion via push: the SOURCE (local) oid is all zeros.
  case "$local_oid" in
    0000000000000000000000000000000000000000)
      echo "BLOCKED: branch/tag deletion via push is disabled by repository policy." >&2
      exit 1 ;;
  esac

  # 2026-08-07: 走 PR 流程后，直推 master 被拦截；仅放行 feat/* 分支（见 docs/PR_PROCESS.md）
  # 2026-08-10: 放开 annotated 语义化版本 tag（refs/tags/v*，发版锚点）；其余 tag 仍拦截。
  case "$remote_ref" in
    refs/tags/v*)
      # 仅放行 annotated tag（git object type == tag），防 lightweight tag 滥用。
      # 发版纪律见 docs/RELEASING.md（bump + tag + CHANGELOG 三步绑定）。
      if git cat-file -t "$local_oid" 2>/dev/null | grep -qx 'tag'; then
        : # 放行 annotated v* 版本 tag
      else
        echo "BLOCKED: tag '$local_ref' is not an annotated tag." >&2
        echo "         Version tags must be annotated (git tag -a vX.Y.Z -m msg). Aborting." >&2
        exit 1
      fi
      ;;
    refs/tags/*)
      echo "BLOCKED: tag push is restricted to annotated version tags (refs/tags/v*)." >&2
      echo "         Only feat/* branches and annotated v* tags may be pushed." >&2
      exit 1 ;;
    refs/heads/master)
      echo "BLOCKED: pushing directly to 'master' is disabled by repository policy." >&2
      echo "         All changes must go through a Pull Request (see docs/PR_PROCESS.md)." >&2
      echo "         Push to a feature branch (feat/*) and open a PR instead. Aborting." >&2
      exit 1 ;;
    refs/heads/feat/*)
      : ;;  # 放行
    *)
      branch="${remote_ref#refs/heads/}"
      echo "BLOCKED: pushing to branch '$branch' is not allowed." >&2
      echo "         Only feat/* branches may be pushed (see docs/PR_PROCESS.md). Aborting." >&2
      exit 1 ;;
  esac

  # Block pushing to a non-canonical remote (e.g. the gitee closed-source mirror)
  remote_url=$(git remote get-url "$remote_name" 2>/dev/null || true)
  case "$remote_url" in
    *"$CANONICAL_REMOTE_SUBSTR"*) ;;
    *)
      echo "BLOCKED: remote '$remote_name' ($remote_url) is not the canonical publish remote." >&2
      echo "         Must push to '$CANONICAL_REMOTE_SUBSTR'. Aborting." >&2
      exit 1 ;;
  esac
done

# ---- OpenCodeReview 门禁（与 CI ocr-review.yml 共用 scripts/ocr-review.sh）----
# 安全守卫通过后，审查本次推送范围。默认只报告；OCR_GATE=1 时发现评论即拦截。
ZERO="0000000000000000000000000000000000000000"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUNNER="$SCRIPT_DIR/../scripts/ocr-review.sh"
GATE_FLAG=""
[ "${OCR_GATE:-0}" = "1" ] && GATE_FLAG="--gate"

while read lref loid rref roid || [ -n "$lref" ]; do
  case "$lref" in refs/heads/*) ;; *) continue;; esac
  if [ "$roid" = "$ZERO" ]; then
    # 新建分支：对比默认可达主干，优先用推送 remote（$1）的 ref
    push_remote="$1"
    base="$(git rev-parse --verify "$push_remote/HEAD" 2>/dev/null \
        || git rev-parse --verify "$push_remote/main" 2>/dev/null \
        || git rev-parse --verify "$push_remote/master" 2>/dev/null \
        || git rev-parse --verify origin/main 2>/dev/null \
        || git rev-parse --verify origin/master 2>/dev/null || echo "")"
    if [ -z "$base" ]; then
      echo "[ocr] 新分支且无可对比主干，跳过审查"; continue
    fi
    echo "[ocr] 新分支 -> 审查 $base..$loid"
    range_args=(--from "$base" --to "$loid")
  else
    echo "[ocr] 审查推送范围 $roid..$loid"
    range_args=(--from "$roid" --to "$loid")
  fi
  "$RUNNER" $GATE_FLAG "${range_args[@]}" || {
    rc=$?
    if [ "$rc" = "1" ]; then
      echo "[ocr] 门禁拦截推送（可用 'git push --no-verify' 强制，不推荐）"
      exit 1
    fi
    echo "[ocr] 审查运行异常(rc=$rc)，未阻断推送"
  }
done

exit 0
