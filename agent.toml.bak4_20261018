[orchestration.tool_summary]
enabled = false
threshold_chars = 8192
start_round = 4
max_per_round = 2

[orchestration.read_parallel]
enabled = false
max_concurrent = 4

# ── 分级审批（2026-09-03，ADR-016 修订）──
# mode: human_all=全部人工（现状，零行为变化）| llm_auto=可逆写操作经 LLM judge 自动批准
# 硬人工名单（删除/大范围同步/关停/导出/身份变更，见 gateway_approval.rs）永远人工，不受 auto_tools 影响
# judge 失败/超时/每日配额满 → fail-safe 转人工
[gateway_approval]
mode = "llm_auto"
daily_quota = 50
judge_timeout_ms = 8000
auto_tools = [
  "manage_whitelist",
  "fill_excel_log",
  "generate_month_log",
  "manage_holiday",
  "organize_folders",
  "archive_operate",
  "manage_samples",
]

# 审批 judge 专用：deepseek-v4-flash（快、判定质量好、同 DeepSeek key）
[gateway_approval.judge]
base_url = "https://api.deepseek.com"
model = "deepseek-v4-flash"
api_key = "${AGENT_API_KEY}"
chat_path = "/v1/chat/completions"

