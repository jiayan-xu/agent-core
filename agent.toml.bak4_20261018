[meta_evolution]
# LEGACY (D7/R1)：维护/进化决策已移交 dsh（经网关 agentcore_tool_execute 触发）。
# 以下保留为被动触发（dsh 调用时才执行），不再主动调度。
# R4 评审时决定是否删除。
enabled = false
window_days = 30
min_samples = 20
holdout_ratio = 0.2
improve_threshold = 0.05
max_rollback_rate = 0.15
cooldown_hours = 24
optimizer_model = "deepseek-v4-flash"

[meta_evolution.budget]
max_turns = 20
max_tokens = 500000
max_wall_clock_secs = 120
max_continuations_per_window = 5
continuation_window_secs = 3600
gate_command = ""

[safety]
approval_mode = "human_in_loop"
high_risk_tools = [
    "delete_*",
    "export_*",
    "send_*",
    "upload_*",
    "webhook_*",
]
high_risk_change_types = [
    "supersede",
    "override",
]

[code_evolution]
enabled = true
target_path = "C:/Users/user/evo-sandbox/src/lib.rs"
generations = 4
circuit_failures = 3
dry_run_default = true
allow_commit = true
evolve_key = "a1560c77ef40ce10e8326e078f142fbe"
fn_name = "fib"

[code_evolution.budget]
max_turns = 8
max_tokens = 200000
max_wall_clock_secs = 300
max_continuations_per_window = 0
continuation_window_secs = 0
gate_command = ""

[features]
skill_library = true
lats = false        # R3 冻结（2026-08-23）
multiagent = false  # R3 冻结
ttc = false         # R3 冻结
persona_auto_memory = true

[lats]
enabled = false
