[intake_filter]
enabled = true
test_ns_isolation = true
a2a_receipt_drop = true
dialog_substance = true
min_substance_len = 12
quarantine_ns = ""

[orchestration.bootstrap]
enabled = true
max_tokens = 1024
max_tools = 3

[orchestration.plan_reflect]
enabled = false
